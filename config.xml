<?xml version='1.0' encoding='utf-8'?>
<widget id="com.atomic.boilerplate.cordova" ios-CFBundleIdentifier="com.ios.atomic.boilerplate.cordova" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>HelloCordova</name>
    <description>Sample Apache Cordova App</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <!-- Must be "about:*", not "about:blank". CDVAllowList grants the empty-host
         exemption only to file: and content:, so an "about:blank" entry parses as
         host="blank" and never matches, because a real about: URL has a nil host.
         The SDK renders its stream container in an iframe via srcdoc, so both
         about:blank and about:srcdoc must pass the navigation filter. -->
    <allow-navigation href="about:*" />

    <preference name="EnableViewportScale" value="true"/>
    <preference name="deployment-target" value="15.0"/>

    <platform name="ios">
      <!-- CordovaLib ships with a deployment target of 11.0, and `cordova prepare`
           regenerates the Podfile, resetting every pod to its podspec deployment
           target (9.0/10.0/11.0). The current Xcode rejects both. This hook
           raises them to IPHONEOS_DEPLOYMENT_TARGET = 15.0 after each prepare.
           See scripts/fix-ios-deployment-target.js. -->
      <hook type="after_prepare" src="scripts/fix-ios-deployment-target.js" />
    </platform>

    <platform name="android">
      <resource-file src="google-services.json" target="/app/google-services.json" />
    </platform>

</widget>
