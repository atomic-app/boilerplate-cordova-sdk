<?xml version='1.0' encoding='utf-8'?>
<widget id="com.atomic.boilerplate.cordova" ios-CFBundleIdentifier="com.ios.atomic.boilerplate.cordova" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>HelloCordova</name>
    <description>Sample Apache Cordova App</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Not needed by Web SDK 26.3.0, which renders the stream container into a shadow
         root, but kept on this branch because `npm run fetch-sdk` can point the app at an
         older or candidate bundle. 26.2.0 and earlier render it in a srcdoc iframe, and
         without this the cards do not appear at all on iOS.

         It must be "about:*", not "about:blank": CDVAllowList grants the empty-host
         exemption only to file: and content:, so an "about:blank" entry parses as
         host="blank" and never matches, because a real about: URL has a nil host. Both
         about:blank and about:srcdoc have to pass the navigation filter. -->
    <allow-navigation href="about:*" />

    <preference name="EnableViewportScale" value="true"/>
    <preference name="deployment-target" value="15.0"/>

    <platform name="ios">
      <!-- Firebase's Google dependencies (GoogleUtilities, GoogleDataTransport, nanopb,
           PromisesObjC) still declare iOS 9.0/12.0 deployment targets, which current
           Xcode rejects outright, and `cordova prepare` regenerates the Podfile and so
           resets them every time. This hook raises every pod to the deployment target
           above after each prepare. See scripts/fix-ios-pod-deployment-target.js. -->
      <hook type="after_prepare" src="scripts/fix-ios-pod-deployment-target.js" />
    </platform>

    <platform name="android">
      <resource-file src="google-services.json" target="/app/google-services.json" />
    </platform>

</widget>
