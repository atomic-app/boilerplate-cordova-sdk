{
  "name": "com.atomic.boilerplate.cordova",
  "displayName": "HelloCordova",
  "version": "1.0.0",
  "description": "A sample Apache Cordova application that responds to the deviceready event.",
  "main": "index.js",
  "scripts": {
    "ios": "cordova build ios && cordova emulate ios",
    "android": "cordova build android && cordova emulate android",
    "token": "node scripts/generate-token.js",
    "update-sdk": "node scripts/update-sdk.js"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Apache Cordova Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@havesource/cordova-plugin-push": "^4.0.0",
    "cordova-ios": "^6.2.0",
    "cordova-plugin-device": "^2.1.0",
    "jsonwebtoken": "^9.0.3"
  },
  "cordova": {
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": {
      "cordova-plugin-device": {},
      "@havesource/cordova-plugin-push": {
        "IOS_FIREBASE_MESSAGING_VERSION": "~> 8.1.1"
      }
    }
  },
  "dependencies": {
    "cordova-android": "13.0.0"
  },
  "atomicWebSdk": {
    "version": "26.2.0",
    "downloadUrl": "https://downloads.atomic.io/web-sdk/release/26.2.0/sdk.js",
    "vendoredAt": "www/js/sdk.js"
  }
}
