opt_out_usage
default_platform(:ios)

BUNDLE_ID = File.read(File.join(__dir__, "..", "config.xml"))[/ios-CFBundleIdentifier="([^"]+)"/, 1]

platform :ios do
  before_all do
    setup_circle_ci

    import_certificate(
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"],
      certificate_path: "DevelopmentCertificate.p12",
      certificate_password: ENV["IOS_CERTIFICATE_PASSWORD"] || ""
    )
  end

  desc "Builds a development-signed ipa for device testing"
  lane :build_test_ipa do
    # cordova platform add ios generates a fresh Xcode project with no DEVELOPMENT_TEAM
    # set (normally picked by hand in Xcode's Signing & Capabilities UI), so archiving
    # fails with "requires a development team" unless forced here. xcargs forces the
    # same manual signing for the archive step that export_options already specifies
    # for the export step, rather than relying on whatever signing style the generated
    # project happens to default to.
    build_ios_app(
      workspace: "platforms/ios/HelloCordova.xcworkspace",
      configuration: "Release",
      scheme: "HelloCordova",
      silent: false,
      clean: true,
      output_directory: "build/ipa",
      output_name: "HelloCordova.ipa",
      xcargs: "DEVELOPMENT_TEAM=#{ENV['IOS_TEAM_ID']} CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER=\"#{ENV['IOS_PROVISIONING_PROFILE_NAME']}\" CODE_SIGN_IDENTITY=\"Apple Development\"",
      export_options: {
        method: "development",
        provisioningProfiles: {
          BUNDLE_ID => ENV["IOS_PROVISIONING_PROFILE_NAME"]
        }
      }
    )
  end
end
