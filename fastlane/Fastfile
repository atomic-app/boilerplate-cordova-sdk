opt_out_usage
default_platform(:ios)

BUNDLE_ID = File.read(File.join(__dir__, "..", "config.xml"))[/ios-CFBundleIdentifier="([^"]+)"/, 1]

platform :ios do
  before_all do
    setup_circle_ci

    import_certificate(
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"],
      certificate_path: "DevelopmentCertificate.p12",
      certificate_password: ENV["IOS_CERTIFICATE_PASSWORD"] || ""
    )
  end

  desc "Builds a development-signed ipa for device testing"
  lane :build_test_ipa do
    # cordova platform add ios generates a fresh Xcode project with Automatic signing
    # and no DEVELOPMENT_TEAM set (normally picked by hand in Xcode's Signing &
    # Capabilities UI), which fails to archive both because there's no team and
    # because Automatic signing needs a logged-in Apple ID account to resolve
    # against, which this CI machine doesn't have.
    #
    # update_code_signing_settings, scoped to just the HelloCordova target, switches
    # only that target to manual signing with our team/profile/identity - as opposed
    # to setting CODE_SIGN_STYLE/PROVISIONING_PROFILE_SPECIFIER via build_ios_app's
    # xcargs, which would apply to every target in the workspace and break the
    # Firebase pods (FirebaseCoreDiagnostics, GoogleUtilities, nanopb, ...): those are
    # libraries that reject having any provisioning profile assigned at all, and are
    # left on whatever signing CocoaPods gave them.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "platforms/ios/HelloCordova.xcodeproj",
      team_id: ENV["IOS_TEAM_ID"],
      code_sign_identity: "Apple Development",
      profile_name: ENV["IOS_PROVISIONING_PROFILE_NAME"],
      targets: ["HelloCordova"]
    )

    build_ios_app(
      workspace: "platforms/ios/HelloCordova.xcworkspace",
      configuration: "Release",
      scheme: "HelloCordova",
      silent: false,
      clean: true,
      output_directory: "build/ipa",
      output_name: "HelloCordova.ipa",
      export_options: {
        method: "development",
        provisioningProfiles: {
          BUNDLE_ID => ENV["IOS_PROVISIONING_PROFILE_NAME"]
        }
      }
    )
  end
end
